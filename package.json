{
  "name": "JAMS-Frontend",
  "version": "0.1.4",
  "description": "Just a Microbiology System (JAMS) - a suite for analyzing microbiological sequencing data for use on NIH HPC systems (Biowulf)",
  "main": "main.js",
  "scripts": {
    "start": "parcel public/index.html --open",
    "build": "parcel build public/index.html --dist-dir renderer --public-url ./ && shx cp main.js renderer/main.js && shx cp preload.js renderer/preload.js",
    "electron-dev": "cross-env concurrently \"npm run start\" \"wait-on http://localhost:1234 && electron .\"",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "concurrently": "^6.5.1",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.6",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.3.9",
    "parcel": "^2.13.3",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shx": "^0.4.0",
    "wait-on": "^5.3.0"
  },
  "targets": {
    "main": false,
    "default": {
      "context": "browser",
      "distDir": "./renderer"
    }
  },
  "build": {
    "appId": "com.example.react-electron-app",
    "win": {
      "sign": false
    },
    "compression": "normal",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "files": [
      "renderer/**/*",
      "main.js",
      "preload.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tmossington",
        "repo": "JAMS-Frontend"
      }
    ]
  }
}
